title Diagramma UML delle classi — Progetto MAP 2026\n<size:12>Codice di produzione in <b>src/</b> ed <b>estensioni/</b></size>

package "data" #EAF4FF {
  abstract class Attribute {
    -name: String
    -index: int
    +Attribute(name: String, index: int)
    +getName(): String
    +getIndex(): int
    +toString(): String
  }

  class ContinuousAttribute {
    +ContinuousAttribute(name: String, index: int)
  }

  class DiscreteAttribute {
    -values: String[]
    +DiscreteAttribute(name: String, index: int, values: String[])
    +getNumberOfDistinctValues(): int
    +getValue(i: int): String
  }

  class Data {
    -data: Object[][]
    -numberOfExamples: int
    -explanatorySet: Attribute[]
    -classAttribute: ContinuousAttribute
    +Data(fileName: String) throws TrainingDataException
    +getNumberOfExamples(): int
    +getNumberOfExplanatoryAttributes(): int
    +getClassValue(exampleIndex: int): Double
    +getExplanatoryValue(exampleIndex: int, attributeIndex: int): Object
    +getExplanatoryAttribute(index: int): Attribute
    +getClassAttribute(): ContinuousAttribute
    +sort(attribute: Attribute, begin: int, end: int): void
    +toString(): String
    -readSchema(sc: Scanner): void throws TrainingDataException
    -readData(sc: Scanner): void throws TrainingDataException
  }

  class TrainingDataException <<exception>> {
    +TrainingDataException(message: String)
    +TrainingDataException(cause: Exception)
  }
}

package "tree" #EFFAF1 {
  abstract class Node {
    {static} #idNodeCount: int = 0
    #idNode: int
    #beginExampleIndex: int
    #endExampleIndex: int
    #variance: double
    +Node(trainingSet: Data, begin: int, end: int)
    +getIdNode(): int
    +getBeginExampleIndex(): int
    +getEndExampleIndex(): int
    +getVariance(): double
    {abstract} +getNumberOfChildren(): int
    +toString(): String
  }

  abstract class SplitNode {
    #attribute: Attribute
    #mapSplit: SplitInfo[]
    #splitVariance: double
    +SplitNode(trainingSet: Data, begin: int, end: int, attribute: Attribute)
    {abstract} +setSplitInfo(trainingSet: Data, begin: int, end: int, attribute: Attribute): void
    {abstract} +testCondition(value: Object): int
    ~getAttribute(): Attribute
    +getVariance(): double
    +getNumberOfChildren(): int
    ~getSplitInfo(child: int): SplitInfo
    +formulateQuery(): String
    +toString(): String
  }

  class SplitInfo <<inner>> {
    ~splitValue: Object
    ~beginIndex: int
    ~endIndex: int
    ~numberChild: int
    ~comparator: String = "="
    ~SplitInfo(splitValue: Object, begin: int, end: int, child: int)
    ~SplitInfo(splitValue: Object, begin: int, end: int, child: int, comparator: String)
    ~getBeginindex(): int
    ~getEndIndex(): int
    ~getSplitValue(): Object
    ~getComparator(): String
    +toString(): String
  }

  class DiscreteNode {
    +DiscreteNode(trainingSet: Data, begin: int, end: int, attribute: DiscreteAttribute)
    +setSplitInfo(trainingSet: Data, begin: int, end: int, attribute: Attribute): void
    +testCondition(value: Object): int
    +toString(): String
  }

  class LeafNode {
    -predictedClassValue: Double
    +LeafNode(trainingSet: Data, begin: int, end: int)
    +getPredictedClassValue(): Double
    +getNumberOfChildren(): int
    +toString(): String
  }

  class RegressionTree {
    -root: Node
    -childTree: RegressionTree[]
    +RegressionTree()
    +RegressionTree(trainingSet: Data)
    +getRoot(): Node
    +getChildren(): RegressionTree[]
    ~isLeaf(trainingSet: Data, begin: int, end: int, maxPerLeaf: int): boolean
    ~determineBestSplitNode(trainingSet: Data, begin: int, end: int): SplitNode
    ~learnTree(trainingSet: Data, begin: int, end: int, maxPerLeaf: int): void
    +printTree(): void
    +printRules(): void
    ~printRules(current: String): void
    +toString(): String
    +predictClass(): Double throws UnknownValueException
  }

  class UnknownValueException <<exception>> {
    +UnknownValueException(message: String)
  }
}

package "estensioni" #FFF4E6 {
  class VisualTree <<final>> {
    {static} -NUMBER_FORMAT: DecimalFormat
    -root: VisualNode
    -VisualTree(root: VisualNode)
    {static} ~from(tree: RegressionTree): VisualTree
    ~getRoot(): VisualNode
    ~getStatistics(): String
    ~getLevelCount(): int
    {static} -createNode(tree: RegressionTree, branch: String): VisualNode
    {static} -attributeName(query: String): String
    {static} -branchName(query: String): String
    {static} -condition(query: String): String
    {static} -countNodes(node: VisualNode): int
    {static} -countLeaves(node: VisualNode): int
    {static} -depth(node: VisualNode): int
  }

  class VisualNode <<static inner, final>> {
    ~title: String {readOnly}
    ~meta: String {readOnly}
    ~branch: String {readOnly}
    ~leaf: boolean {readOnly}
    ~children: List<VisualNode> = new ArrayList<VisualNode>() {readOnly}
    ~subtreeWidth: int
    ~x: int
    ~y: int
    ~VisualNode(title: String, meta: String, branch: String, leaf: boolean)
  }

  class RegressionTreeCanvas <<final>> {
    {static} -serialVersionUID: long = 1
    {static} -PAPER: Color
    {static} -INK: Color
    {static} -MUTED: Color
    {static} -RED: Color
    {static} -NODE_WIDTH: int = 200
    {static} -NODE_HEIGHT: int = 72
    {static} -HORIZONTAL_GAP: int = 48
    {static} -LEVEL_GAP: int = 90
    {static} -MARGIN: int = 36
    -tree: VisualTree {transient}
    -scale: double = 1.0
    -baseWidth: int = 600
    -baseHeight: int = 460
    ~RegressionTreeCanvas()
    ~setTree(tree: VisualTree): void
    ~setScale(scale: double): void
    ~hasTree(): boolean
    ~getScale(): double
    ~getRootCenterX(): double
    +getPreferredSize(): Dimension
    #paintComponent(graphics: Graphics): void
    -layoutTree(): void
    -measure(node: VisualNode): int
    -layout(node: VisualNode, left: int, top: int): void
    -drawEdges(g: Graphics2D, node: VisualNode): void
    -drawBranch(g: Graphics2D, text: String, centerX: int, centerY: int): void
    -drawNodes(g: Graphics2D, node: VisualNode): void
    -drawNode(g: Graphics2D, node: VisualNode): void
    -drawCentered(g: Graphics2D, text: String, x: int, baseline: int): void
    -fit(text: String, metrics: FontMetrics, maxWidth: int): String
  }

  class RegressionTreeGUI <<final>> {
    {static} -serialVersionUID: long = 1
    {static} ~PAPER: Color
    {static} ~INK: Color
    {static} ~MUTED: Color
    {static} ~RED: Color
    {static} -BUTTON_UI: BasicButtonUI
    -fileField: JTextField
    -detailsArea: JTextArea
    -detailsButton: JButton
    -statusLabel: JLabel
    -treeCanvas: RegressionTreeCanvas
    -graphScroll: JScrollPane
    +RegressionTreeGUI()
    -createTop(): JPanel
    -createHeader(): JPanel
    -createControls(): JPanel
    -createCenter(): JPanel
    -zoomBy(amount: double, zoomValue: JLabel): void
    -chooseFile(): void
    -showDetails(): void
    -train(): void
    -centerTree(): void
    -showError(message: String): void
    {static} -styleButton(button: JButton, background: Color, foreground: Color): void
    {static} +main(args: String[]): void
  }
}

package "utility" #F5F0FF {
  class Keyboard {
    {static} -printErrors: boolean = true
    {static} -errorCount: int = 0
    {static} -current_token: String
    {static} -reader: StringTokenizer
    {static} -in: BufferedReader
    {static} +getErrorCount(): int
    {static} +resetErrorCount(count: int): void
    {static} +getPrintErrors(): boolean
    {static} +setPrintErrors(flag: boolean): void
    {static} -error(str: String): void
    {static} -getNextToken(): String
    {static} -getNextToken(skip: boolean): String
    {static} -getNextInputToken(skip: boolean): String
    {static} +endOfLine(): boolean
    {static} +readString(): String
    {static} +readWord(): String
    {static} +readBoolean(): boolean
    {static} +readChar(): char
    {static} +readInt(): int
    {static} +readLong(): long
    {static} +readFloat(): float
    {static} +readDouble(): double
  }
}

package "applicazione (default package)" #F8F9FA {
  class MainTest {
    {static} +main(args: String[]): void
  }
}

package "java.util (tipi di libreria usati)" #FFF9DB {
  interface "List<E>" as JavaList <<template>> {
    +add(element: E): boolean
    +get(index: int): E
    +size(): int
    +isEmpty(): boolean
  }

  class "ArrayList<E>" as JavaArrayList <<template>> {
    +ArrayList()
    +add(element: E): boolean
    +get(index: int): E
    +size(): int
  }

  class StringTokenizer <<external>>
}

package "tipi esterni Java e Swing" #F1F3F5 {
  class Exception <<external>>
  class BufferedReader <<external>>
  class JFrame <<external>>
  class JPanel <<external>>
}

' Generalizzazioni del dominio.
ContinuousAttribute --|> Attribute
DiscreteAttribute --|> Attribute
SplitNode --|> Node
DiscreteNode --|> SplitNode
LeafNode --|> Node

' Eccezioni e classi Swing.
TrainingDataException --|> Exception
UnknownValueException --|> Exception
RegressionTreeGUI --|> JFrame
RegressionTreeCanvas --|> JPanel

' Composizioni e aggregazioni del modello.
Data "1" *-- "0..*" Attribute : explanatorySet
Data "1" *-- "0..1" ContinuousAttribute : classAttribute
SplitNode "1" *-- "0..*" SplitInfo : mapSplit
SplitNode "0..*" o-- "1" Attribute : attribute
RegressionTree "1" *-- "0..1" Node : root
RegressionTree "1" *-- "0..*" RegressionTree : childTree
VisualTree "1" *-- "1" VisualNode : root
RegressionTreeGUI "1" *-- "1" RegressionTreeCanvas : treeCanvas
RegressionTreeCanvas "1" o-- "0..1" VisualTree : tree

' Collezione Java esplicitata come template, come richiesto nella revisione UML.
JavaArrayList ..|> JavaList : implements
VisualNode "1" o-- "1" JavaArrayList : children\n«bind» E = VisualNode
JavaArrayList "1" o-- "0..*" VisualNode : elements\nE = VisualNode

note on link
  Il campo usa <b>List</b> con parametro VisualNode
  ed è istanziato con <b>ArrayList</b> con parametro VisualNode.
  ArrayList e List sono mostrate come template Java.
end note

' Relazione fra classi interne e contenitrici.
SplitNode .. SplitInfo : «inner»
VisualTree .. VisualNode : «static inner»

' Dipendenze principali (parametri, creazione e invocazioni).
Node ..> Data : calcola SSE da
SplitNode ..> Data : ordina/partiziona
DiscreteNode ..> DiscreteAttribute : usa
RegressionTree ..> Data : apprende da
RegressionTree ..> Keyboard : acquisisce scelta
RegressionTree ..> UnknownValueException : solleva
VisualTree ..> RegressionTree : converte
RegressionTreeGUI ..> Data : crea
RegressionTreeGUI ..> RegressionTree : crea
RegressionTreeGUI ..> TrainingDataException : gestisce
MainTest ..> Data : crea
MainTest ..> RegressionTree : crea
MainTest ..> Keyboard : usa
MainTest ..> TrainingDataException : gestisce
MainTest ..> UnknownValueException : gestisce
Keyboard "1" o-- "0..1" StringTokenizer : reader {static}
Keyboard "1" o-- "1" BufferedReader : in {static}

note bottom of JavaArrayList
  <b>Classe template Java</b>
  Parametro formale: E
  Binding usato nel progetto: E = VisualNode
end note

@enduml
