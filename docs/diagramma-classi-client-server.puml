@startuml
' UML delle classi nei componenti distribuiti.
' Sono incluse tutte le classi di produzione di mapClient/ e mapServer/.
' I test e le copie compilate non fanno parte del modello.

left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 10
skinparam nodesep 40
skinparam ranksep 60
skinparam ArrowColor #343A40
skinparam ClassBorderColor #343A40
skinparam ClassBackgroundColor #F8F9FA
skinparam PackageBorderColor #6C757D
skinparam PackageBackgroundColor #FFFFFF
skinparam stereotypeCBackgroundColor #F1F3F5
skinparam stereotypeCBorderColor #868E96
skinparam stereotypeEBackgroundColor #FFF4D6
skinparam stereotypeEBorderColor #9A6700
hide empty members

title Diagramma UML delle classi — client/server

package "map7Client" #EAF4FF {
  class MainTest {
    {static} + main(args: String[]): void
  }
}

package "utility (client)" #F5F0FF {
  class Keyboard {
    {static} - printErrors: boolean
    {static} - errorCount: int
    {static} + getErrorCount(): int
    {static} + resetErrorCount(count: int): void
    {static} + getPrintErrors(): boolean
    {static} + setPrintErrors(flag: boolean): void
    {static} + endOfLine(): boolean
    {static} + readString(): String
    {static} + readWord(): String
    {static} + readBoolean(): boolean
    {static} + readChar(): char
    {static} + readInt(): int
    {static} + readLong(): long
    {static} + readFloat(): float
    {static} + readDouble(): double
  }
}

package "server" #FFF4E6 {
  class Server {
    {static} + main(args: String[]): void
  }

  class MultiServer {
    - PORT: int
    + MultiServer(port: int)
    - run(): void
  }

  class ServerOneClient {
    - socket: Socket
    - in: ObjectInputStream
    - out: ObjectOutputStream
    - trainingSet: Data
    - tree: RegressionTree
    - fileName: String
    + ServerOneClient(socket: Socket)
    + run(): void
    - loadData(): void
    - learnTree(): void
    - loadTree(): void
    - predict(): void
  }

  class UnknownValueException {
    + UnknownValueException(message: String)
  }
}

package "data (mapServer)" #EAF4FF {
  abstract class Attribute {
    - name: String
    - index: int
    + Attribute(name: String, index: int)
    + getName(): String
    + getIndex(): int
    + toString(): String
  }

  class ContinuousAttribute {
    + ContinuousAttribute(name: String, index: int)
  }

  class DiscreteAttribute {
    - values: Set<String>
    + DiscreteAttribute(name: String, index: int, values: Set<String>)
    + getNumberOfDistinctValues(): int
    + iterator(): Iterator<String>
  }

  class Data {
    - data: List<Example>
    - numberOfExamples: int
    - explanatorySet: List<Attribute>
    - classAttribute: ContinuousAttribute
    + Data(tableName: String)
    + getNumberOfExamples(): int
    + getNumberOfExplanatoryAttributes(): int
    + getClassValue(exampleIndex: int): Double
    + getExplanatoryValue(exampleIndex: int, attributeIndex: int): Object
    + getExplanatoryAttribute(index: int): Attribute
    + getClassAttribute(): ContinuousAttribute
    + sort(attribute: Attribute, begin: int, end: int): void
    + toString(): String
  }

  class TrainingDataException {
    + TrainingDataException(message: String)
    + TrainingDataException(cause: Exception)
  }
}

package "database" #FFF9DB {
  class Column {
    - name: String
    - type: String
    ~ Column(name: String, type: String)
    + getColumnName(): String
    + isNumber(): boolean
    + toString(): String
  }

  class DbAccess {
    - SERVER: String
    - DATABASE: String
    - PORT: String
    - USER_ID: String
    - PASSWORD: String
    - conn: Connection
    + initConnection(): void
    + getConnection(): Connection
    + closeConnection(): void
  }

  class Example {
    - example: List<Object>
    + Example()
    + add(value: Object): void
    + get(index: int): Object
    + compareTo(other: Example): int
    + iterator(): Iterator<Object>
    + toString(): String
  }

  class TableData {
    - db: DbAccess
    + TableData(db: DbAccess)
    + getTransazioni(table: String): List<Example>
    + getDistinctColumnValues(table: String, column: Column): Set<Object>
  }

  class "TableData.QUERY_TYPE" as QUERY_TYPE {
    MIN
    MAX
  }

  class TableSchema {
    - tableSchema: List<Column>
    + TableSchema(db: DbAccess, tableName: String)
    + getNumberOfAttributes(): int
    + getColumn(index: int): Column
    + iterator(): Iterator<Column>
  }

  class DatabaseConnectionException {
    + DatabaseConnectionException(message: String)
    + DatabaseConnectionException(cause: Exception)
  }

  class EmptySetException {
    + EmptySetException()
    + EmptySetException(message: String)
  }
}

package "tree (mapServer)" #EFFAF1 {
  abstract class Node {
    {static} # idNodeCount: int = 0
    # idNode: int
    # beginExampleIndex: int
    # endExampleIndex: int
    # variance: double
    + Node(trainingSet: Data, begin: int, end: int)
    + getIdNode(): int
    + getBeginExampleIndex(): int
    + getEndExampleIndex(): int
    + getVariance(): double
    {abstract} + getNumberOfChildren(): int
    + toString(): String
  }

  abstract class SplitNode {
    # attribute: Attribute
    # mapSplit: List<SplitInfo>
    # splitVariance: double
    + SplitNode(trainingSet: Data, begin: int, end: int, attribute: Attribute)
    ~ setSplitInfo(trainingSet: Data, begin: int, end: int, attribute: Attribute): void
    {abstract} + testCondition(value: Object): int
    ~ getAttribute(): Attribute
    + getVariance(): double
    + getNumberOfChildren(): int
    ~ getSplitInfo(child: int): SplitInfo
    + formulateQuery(): String
    + compareTo(other: SplitNode): int
  }

  class SplitInfo {
    ~ splitValue: Object
    ~ beginIndex: int
    ~ endIndex: int
    ~ numberChild: int
    ~ comparator: String
    ~ SplitInfo(value: Object, begin: int, end: int, child: int)
    ~ SplitInfo(value: Object, begin: int, end: int, child: int, comparator: String)
    ~ getBeginindex(): int
    ~ getEndIndex(): int
    ~ getSplitValue(): Object
    ~ getComparator(): String
    + toString(): String
  }

  class ContinuousNode {
    + ContinuousNode(trainingSet: Data, begin: int, end: int, attribute: ContinuousAttribute)
    ~ setSplitInfo(trainingSet: Data, begin: int, end: int, attribute: Attribute): void
    + testCondition(value: Object): int
  }

  class DiscreteNode {
    + DiscreteNode(trainingSet: Data, begin: int, end: int, attribute: DiscreteAttribute)
    ~ setSplitInfo(trainingSet: Data, begin: int, end: int, attribute: Attribute): void
    + testCondition(value: Object): int
  }

  class LeafNode {
    - predictedClassValue: Double
    + LeafNode(trainingSet: Data, begin: int, end: int)
    + getPredictedClassValue(): Double
    + getNumberOfChildren(): int
  }

  class RegressionTree {
    - root: Node
    - childTree: RegressionTree[]
    + RegressionTree()
    + RegressionTree(trainingSet: Data)
    + isLeaf(): boolean
    + getPredictedClassValue(): Double
    + formulateQuery(): String
    + getNumberOfChildren(): int
    + getChild(index: int): RegressionTree
    + printTree(): void
    + printRules(): void
    + toString(): String
    + salva(fileName: String): void
    {static} + carica(fileName: String): RegressionTree
  }
}

package "Java API — tipi utilizzati" #F1F3F5 {
  class "Serializable" as JSerializable <<interface>>
  class "Iterable<T>" as JIterable <<interface>>
  class "Comparable<T>" as JComparable <<interface>>
  class "List<E>" as JList <<interface>>
  class "Set<E>" as JSet <<interface>>
  class "Map<K,V>" as JMap <<interface>>
  class "Iterator<E>" as JIterator <<interface>>
  class "ArrayList<E>" as JArrayList
  class "LinkedList<E>" as JLinkedList
  class "TreeSet<E>" as JTreeSet
  class "HashMap<K,V>" as JHashMap
  class "Exception" as JException
  class "Thread" as JThread
  class "Socket" as JSocket
  class "ServerSocket" as JServerSocket
  class "ObjectInputStream" as JObjectInputStream
  class "ObjectOutputStream" as JObjectOutputStream
  class "Connection" as JConnection
  class "DriverManager" as JDriverManager
  class "DatabaseMetaData" as JDatabaseMetaData
  class "Statement" as JStatement
  class "ResultSet" as JResultSet
  class "SQLException" as JSQLException
}

' Generalizzazioni, realizzazioni e classi annidate.
ContinuousAttribute --|> Attribute
DiscreteAttribute --|> Attribute
ContinuousNode --|> SplitNode
DiscreteNode --|> SplitNode
LeafNode --|> Node
SplitNode --|> Node
ServerOneClient --|> JThread
Attribute ..|> JSerializable
Node ..|> JSerializable
RegressionTree ..|> JSerializable
SplitInfo ..|> JSerializable
DiscreteAttribute ..|> JIterable : E = String
Example ..|> JComparable : T = Example
Example ..|> JIterable : E = Object
TableSchema ..|> JIterable : E = Column
SplitNode ..|> JComparable : T = SplitNode
TrainingDataException --|> JException
UnknownValueException --|> JException
DatabaseConnectionException --|> JException
EmptySetException --|> JException
JArrayList ..|> JList
JLinkedList ..|> JList
JTreeSet ..|> JSet
JHashMap ..|> JMap

' Struttura dati, albero e database.
Data "1" o-- "0..*" Example : data
Data "1" o-- "0..*" Attribute : explanatorySet
Data "1" *-- "1" ContinuousAttribute : classAttribute
TableSchema "1" *-- "0..*" Column : tableSchema
TableData "0..*" o-- "1" DbAccess : db
DbAccess "1" o-- "0..1" JConnection : conn
SplitNode "1" +-- "0..*" SplitInfo : mapSplit / inner class
SplitNode "0..*" o-- "1" Attribute : attribute
RegressionTree "1" *-- "0..1" Node : root
RegressionTree "1" *-- "0..*" RegressionTree : childTree
TableData +-- QUERY_TYPE : nested type
Data ..> JList : data/explanatorySet
DiscreteAttribute ..> JSet : values
DiscreteAttribute ..> JIterator : iterator
Example ..> JList : example
Example ..> JIterator : iterator
TableSchema ..> JList : tableSchema
TableSchema ..> JIterator : iterator
SplitNode ..> JList : mapSplit
Data ..> JArrayList : <<bind>> (Example)
Data ..> JLinkedList : <<bind>> (Attribute, Example)
DiscreteAttribute ..> JTreeSet : <<bind>> (String)
Example ..> JArrayList : <<bind>> (Object)
TableData ..> JLinkedList : <<bind>> (Example)
TableData ..> JTreeSet : <<bind>> (Object)
TableSchema ..> JArrayList : <<bind>> (Column)
TableSchema ..> JHashMap : <<bind>> (String, String)
SplitNode ..> JArrayList : <<bind>> (SplitInfo)
RegressionTree ..> JTreeSet : <<bind>> (SplitNode)

' Server e persistenza.
Server ..> MultiServer : avvia
MultiServer ..> ServerOneClient : crea
MultiServer ..> JServerSocket : ascolta
ServerOneClient "1" o-- "1" JSocket : socket
ServerOneClient "1" o-- "1" JObjectInputStream : in
ServerOneClient "1" o-- "1" JObjectOutputStream : out
ServerOneClient "1" o-- "0..1" Data : trainingSet
ServerOneClient "1" o-- "0..1" RegressionTree : tree
ServerOneClient ..> TrainingDataException : gestisce
ServerOneClient ..> UnknownValueException : solleva
Data ..> DbAccess : connette
Data ..> TableSchema : legge schema
Data ..> TableData : legge tuple
Data ..> TrainingDataException : solleva
DbAccess ..> JDriverManager : apre connessione
DbAccess ..> DatabaseConnectionException : solleva
TableSchema ..> JConnection : metadati
TableSchema ..> JDatabaseMetaData : legge
TableSchema ..> JResultSet : legge
TableSchema ..> JSQLException : solleva
TableData ..> JStatement : esegue query
TableData ..> JResultSet : legge
TableData ..> EmptySetException : solleva
TableData ..> JSQLException : solleva

' Client console e protocollo.
MainTest ..> Keyboard : input
MainTest ..> JSocket : TCP
MainTest ..> JObjectInputStream : riceve oggetti
MainTest ..> JObjectOutputStream : invia oggetti
MainTest ..> ServerOneClient : protocollo (non import)

note bottom of "Java API — tipi utilizzati"
  Sono mostrati i tipi Java/SQL usati dal modello; String, Object e i tipi primitivi
  restano nelle firme senza diventare nodi autonomi.
end note

@enduml
